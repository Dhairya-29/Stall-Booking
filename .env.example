# Copy this file to ".env" (no .txt) and fill in. Lines starting with # are ignored.
ADMIN_PASSWORD=choose-a-strong-password
SITE_URL=http://localhost:3000

# --- Email alerts (e.g. Gmail: use an "App password", not your normal password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
ADMIN_EMAIL=admin1@example.com,admin2@example.com

# --- WhatsApp alerts via CallMeBot: phone(with country code, no +):apikey  (comma-separate several admins) ---
WHATSAPP_ADMINS=919XXXXXXXXX:1234567

# --- SMS login (OTP). SMS_PROVIDER = fast2sms or twilio. Leave blank for TEST MODE (OTP is printed in the server window only) ---
SMS_PROVIDER=fast2sms
FAST2SMS_KEY=your-fast2sms-api-key
# TWILIO_SID=   TWILIO_TOKEN=   TWILIO_FROM=+1xxxxxxxxxx

# Reminder emails go out 24h and 12h before each event's start (event date + its Time field), to the admin and to customers with approved bookings who gave an email.
